{
  "name": "suka87",
  "private": true,
  "version": "0.1.0",
  "description": "Suka 87 — first-person survival shooter. Fight through St. Brendan's Hospital and synthesise the cure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:levels": "esbuild scripts/validate-levels.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/validate-levels.cjs && node node_modules/.cache/validate-levels.cjs"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.172.0",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
